--
-- The Idris2 ABI models and proofs. Type-check with:
--   idris2 --typecheck src/abi/panic-attack-abi.ipkg
-- A pass is exit 0 and no `Error:` line in the output.
package panic-attack-abi

sourcedir = "."

modules = PanicAttack.ABI.Types
        , PanicAttack.ABI.ClassificationSoundness
        , PanicAttack.ABI.Stripping
        , PanicAttack.ABI.AttestationUnforgeability
