K9!
# SPDX-License-Identifier: MPL-2.0
# Configuration contract derived from k9iser.toml.
# Keep the requirements below in sync with that source manifest.
{
  pedigree = {
    schema_version = "1.0.0",
    component_type = "configuration-contract",
    security = {
      leash = 'Hunt,
      signature_required = true,
      allow_network = false,
      allow_filesystem_write = false,
      allow_subprocess = false,
    },
    metadata = {
      name = "cargo-manifest",
      version = "1.0.0",
      description = "Requirements for Cargo.toml",
    },
    side_effects = ["Validation reads the source configuration; no deployment is performed."],
  },

  config = {
    source = "Cargo.toml",
    format = "toml",
  },

  # Declarative requirements; a signature is required before Hunt execution.
  validation = {
    must = [
      "package.name == 'panic-attack'",
      "package.edition == '2021'",
      "package.rust-version is set",
      "package.license-file is set",
      "package.repository is non-empty",
      "profile.release.lto is set",
      "profile.release.codegen-units == 1",
      "profile.release.strip == 'symbols'",
      "profile.release.panic == 'unwind'",
      "dependencies.blake3 is set",
      "dependencies.sha2 is set",
      "no dependency on md5",
      "no dependency on sha1",
    ],
    trust = [
      "signed-by: ci-pipeline",
    ],
    dust = [
      "remove: unused optional features",
    ],
    intend = [
      "production-ready",
      "security-critical",
    ],
  },
}
